---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories, defaultCategory } from '../../data/categories.mjs';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const validIds = new Set(categories.map((c) => c.id));
const categoryOf = (post) => (validIds.has(post.data.category) ? post.data.category : defaultCategory);
const countFor = (id) => posts.filter((p) => categoryOf(p) === id).length;
---
<Layout title="Blog" description="Posts by Thomas Haene, written in Notion and published here.">
  <p class="eyebrow">Writing</p>
  <h1>Blog</h1>
  <p class="lead">Weekly takes on the space industry, plus longer pieces on whatever else has caught my attention.</p>

  <div class="category-toggle" role="group" aria-label="Filter posts by category" data-category-toggle>
    <button type="button" class="category-btn" data-category="all" aria-pressed="true">
      All <span class="count">{posts.length}</span>
    </button>
    {categories.map((c) => (
      <button type="button" class="category-btn" data-category={c.id} aria-pressed="false">
        {c.label} <span class="count">{countFor(c.id)}</span>
      </button>
    ))}
  </div>

  <p class="category-description" data-category-description aria-live="polite"></p>

  {posts.length === 0 && <p>No posts yet — check back soon.</p>}

  <ul class="post-list" data-post-list>
    {posts.map((post) => {
      const cat = categories.find((c) => c.id === categoryOf(post));
      return (
        <li data-category={cat.id}>
          <h3><a href={`${base}blog/${post.slug}/`}>{post.data.title}</a></h3>
          <p class="post-meta">
            <span class="category-badge">{cat.short}</span>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            {post.data.tags.length > 0 && ` · ${post.data.tags.join(', ')}`}
          </p>
          {post.data.description && <p>{post.data.description}</p>}
        </li>
      );
    })}
  </ul>

  <p class="category-empty" data-category-empty hidden>Nothing here yet — check back soon.</p>

  <script is:inline define:vars={{ descriptions: Object.fromEntries(categories.map((c) => [c.id, c.description])) }}>
    (function () {
      var buttons = document.querySelectorAll('[data-category-toggle] .category-btn');
      var items = document.querySelectorAll('[data-post-list] > li');
      var desc = document.querySelector('[data-category-description]');
      var empty = document.querySelector('[data-category-empty]');

      function apply(id, updateUrl) {
        var shown = 0;
        items.forEach(function (li) {
          var match = id === 'all' || li.dataset.category === id;
          li.hidden = !match;
          if (match) shown++;
        });
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.dataset.category === id));
        });
        desc.textContent = descriptions[id] || '';
        empty.hidden = shown !== 0 || items.length === 0;
        if (updateUrl) {
          var url = new URL(window.location.href);
          if (id === 'all') url.searchParams.delete('category');
          else url.searchParams.set('category', id);
          history.replaceState(null, '', url);
        }
      }

      buttons.forEach(function (b) {
        b.addEventListener('click', function () { apply(b.dataset.category, true); });
      });

      var initial = new URLSearchParams(window.location.search).get('category');
      var known = Array.prototype.some.call(buttons, function (b) { return b.dataset.category === initial; });
      apply(known ? initial : 'all', false);
    })();
  </script>
</Layout>
