---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Layout>
  <section class="hero">
    <p class="eyebrow">Hi, I'm</p>
    <h1>Thomas Haene</h1>
    <p class="lead">
      Electrical Engineering Masters student at the University of Toronto specializing with an emphasis in Telecommunications. Headed toward a career in
      the Telecoms Industry. This site is my hub — a bit about me, and a blog where I write about what I'm learning and what I find interesting.
    </p>
    <div class="tags">
      <a class="button" href={`${base}about/`}>About me</a>
      <a class="button secondary" href={`${base}blog/`}>Read the blog</a>
    </div>
  </section>

  {posts.length > 0 && (
    <section>
      <h2>Latest posts</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <h3><a href={`${base}blog/${post.slug}/`}>{post.data.title}</a></h3>
            <p class="post-meta">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            {post.data.description && <p>{post.data.description}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
