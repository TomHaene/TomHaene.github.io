---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
];
const base = import.meta.env.BASE_URL;

function isActive(href: string) {
  if (href === '/') return pathname === base || pathname === `${base}`.replace(/\/?$/, '/');
  return pathname.startsWith(`${base}${href}`.replace('//', '/'));
}
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={base}>Thomas Haene</a>
    <nav class="site-nav">
      {links.map((link) => (
        <a href={`${base}${link.href}`.replace('//', '/')} class:list={[{ active: isActive(link.href) }]}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
